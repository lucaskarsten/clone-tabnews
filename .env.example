# Postgres (DATABASE_URL é usada pelo script migration:up; POSTGRES_CA opcional para SSL com CA própria)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=usuario_exemplo
POSTGRES_DB=banco_exemplo
POSTGRES_PASSWORD=senha_exemplo
DATABASE_URL=postgres://$POSTGRES_USER:$POSTGRES_PASSWORD@$POSTGRES_HOST:$POSTGRES_PORT/$POSTGRES_DB
POSTGRES_CA=

# Senhas: segredo somado à senha antes do bcrypt
PEPPER=troque_este_pepper

# SMTP para envio de emails (nodemailer)
EMAIL_SMTP_HOST=smtp.exemplo.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=usuario_smtp
EMAIL_SMTP_PASSWORD=senha_smtp
EMAIL_SMTP_SECURE=false

# API HTTP do Mailcatcher, usada só pelos testes
EMAIL_HTTP_HOST=localhost
EMAIL_HTTP_PORT=1080

# URL pública do site, usada no link de ativação
WEBSERVER_URL=http://localhost:3000
